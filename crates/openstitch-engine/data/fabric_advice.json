  "fabrics": {
    "standard": {
      "backing": "Tear-away on stable woven cotton; cut-away under dense designs.",
      "topping": "None needed.",
      "needlePoint": "sharp",
      "needleMin": 75,
      "sources": [
        "S1",
        "S2",
        "S7",
        "S8",
        "S10"
      ]
    },
    "thin": {
      "backing": "A light cut-away (no show-through) or a fused tear-away; wash-away on sheer batiste.",
      "topping": "None needed.",
      "needlePoint": "sharp",
      "needleMin": 65,
      "sources": [
        "S1",
        "S3",
        "S7",
        "S8",
        "S10"
      ]
    },
    "heavy": {
      "backing": "Cut-away on denim and heavy twill; a heavy tear-away on stable shirt-weight denim.",
      "topping": "None needed.",
      "needlePoint": "sharp",
      "needleMin": 90,
      "disagree": "OESD and Madeira name cut-away for denim; Madeira and Floriani also give tear-away for shirt-weight denim.",
      "sources": [
        "S2",
        "S6",
        "S7",
        "S8",
        "S10",
        "S15",
        "S22"
      ]
    },
    "knit": {
      "backing": "Cut-away (mesh or medium) so the knit cannot stretch under the stitches; fusible mesh on light designs.",
      "topping": "Water-soluble or heat-away film.",
      "needlePoint": "ballpoint",
      "needleMin": null,
      "disagree": "Sulky hoops an adhesive tear-away instead of the knit.",
      "sources": [
        "S1",
        "S2",
        "S6",
        "S7",
        "S8",
        "S10",
        "S19"
      ]
    },
    "fleece": {
      "backing": "Cut-away (or an adhesive stabiliser without hooping the fleece).",
      "topping": "Water-soluble film, or a permanent topping on textured fleece.",
      "needlePoint": "ballpoint",
      "needleMin": 80,
      "disagree": "Floriani and Sulky also accept an adhesive tear-away.",
      "sources": [
        "S1",
        "S7",
        "S8",
        "S10",
        "S17"
      ]
    },
    "towel": {
      "backing": "Tear-away (adhesive, without hooping the towel); a heavy cut-away on loose pile.",
      "topping": "Water-soluble film so the stitches do not sink into the loops.",
      "needlePoint": "sharp",
      "needleMin": 90,
      "disagree": "OESD, Floriani and Sulky give tear-away; Madeira USA gives a heavy cut-away for pile.",
      "sources": [
        "S1",
        "S6",
        "S7",
        "S8",
        "S10",
        "S20"
      ]
    },
    "felt": {
      "backing": "Tear-away; on felted wool a cut-away works as well.",
      "topping": "None needed.",
      "needlePoint": "sharp",
      "needleMin": 90,
      "sources": [
        "S18"
      ]
    },
    "leather": {
      "backing": "An adhesive tear-away or cut-away, the leather not hooped (every needle hole stays).",
      "topping": "None needed.",
      "needlePoint": "leather",
      "needleMin": null,
      "disagree": "Sulky and Schmetz use a cutting (leather) point; Groz-Beckert advises a round point, as cutting points tear the hide in embroidery; Madeira UK names titanium.",
      "sources": [
        "S1",
        "S7",
        "S8",
        "S10",
        "S11",
        "S12",
        "S14"
      ]
    },
    "polyester": {
      "backing": "Tear-away on stable poly/cotton; a light cut-away on thin or slippery polyester.",
      "topping": "None needed.",
      "needlePoint": "sharp",
      "needleMin": null,
      "sources": [
        "S1",
        "S7",
        "S8",
        "S11"
      ]
    },
    "pique": {
      "backing": "A soft cut-away (mesh) as on other knits.",
      "topping": "Water-soluble or heat-away film over the textured knit.",
      "needlePoint": "ballpoint",
      "needleMin": null,
      "sources": [
        "S1",
        "S2",
        "S6",
        "S7",
        "S10",
        "S23"
      ]
    },
    "organza": {
      "backing": "Wash-away (fusible or adhesive), so nothing shows through the sheer fabric.",
      "topping": "None needed.",
      "needlePoint": "sharp",
      "needleMin": 65,
      "disagree": "No maker gives a needle for organza; OpenStitch uses the general advice of a smaller needle on light fabrics.",
      "sources": [
        "S1",
        "S3",
        "S6",
        "S8",
        "S10"
      ]
    },
    "canvas": {
      "backing": "Tear-away on canvas and duck; cut-away on heavy bag canvas.",
      "topping": "None needed.",
      "needlePoint": "sharp",
      "needleMin": 100,
      "sources": [
        "S2",
        "S6",
        "S7",
        "S8",
        "S11",
        "S16"
      ]
    },
    "cap": {
      "backing": "A cap tear-away (or a stiff cut-away on heavy caps).",
      "topping": "None needed.",
      "needlePoint": "sharp or titanium",
      "needleMin": null,
      "disagree": "Madeira USA says a sharp point and never ballpoint on caps; Madeira UK and Groz-Beckert name titanium-coated needles.",
      "sources": [
        "S1",
        "S2",
        "S7",
        "S8",
        "S12"
      ]
    }
