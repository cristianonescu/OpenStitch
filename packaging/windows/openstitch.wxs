      <Component Id="Notices" Guid="99db175f-5b51-42ff-a4cc-4a9eb2d9f0ba" Win64="yes">
        <File Id="ThirdPartyNotices" Source="$(var.Notices)" Name="THIRD_PARTY_NOTICES.md" KeyPath="yes" />
        <File Id="LicenseMit" Source="LICENSE-MIT" Name="LICENSE-MIT.txt" />
        <File Id="LicenseApache" Source="LICENSE-APACHE" Name="LICENSE-APACHE.txt" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="OpenStitch" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="PesAssociation" />
      <ComponentRef Id="ExplorerThumbnails" />
      <ComponentRef Id="Notices" />
      <ComponentGroupRef Id="SewKit" />
    </Feature>
  </Product>
</Wix>
