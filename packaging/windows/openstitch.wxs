        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620005}\InprocServer32" Value="[#ThumbnailsDll]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620005}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jef\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Value="{4F70656E-5374-6974-6368-54686D620005}" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620006}" Value="OpenStitch thumbnail (.pcs)" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620006}\InprocServer32" Value="[#ThumbnailsDll]" Type="string" />
