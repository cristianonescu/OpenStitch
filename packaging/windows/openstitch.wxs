<?xml version="1.0" encoding="UTF-8"?>
<!--
  OpenStitch MSI (WiX Toolset 3). Built in CI by .github/workflows/build-executables.yml:
    candle -arch x64 -dVersion=0.1.0 -dBinary=target\release\openstitch.exe -dIcon=assets\icons\openstitch.ico -dNotices=THIRD_PARTY_NOTICES.md packaging\windows\openstitch.wxs
    light -out OpenStitch.msi openstitch.wixobj
  Installs per machine into Program Files\OpenStitch, adds a Start-menu shortcut and registers
  .osd (OpenStitch Design) and .pes (Open with OpenStitch) file associations.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="OpenStitch" Language="1033" Version="$(var.Version)"
           Manufacturer="OpenStitch contributors" UpgradeCode="0627e96f-d149-412d-b450-f64869cf1438">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="OpenStitch embroidery design editor" />
    <!-- Every build so far is version 0.1.0 with a new ProductCode: without
         AllowSameVersionUpgrades a same-version MSI installs beside the last one instead of
         replacing it (#742), and Apps & features lists one "OpenStitch 0.1.0" per install. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of OpenStitch is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The Icon table name must end in .ico (or .exe): Windows Installer copies the icon to
         %WINDIR%\Installer\{ProductCode}\<name>, and the shell loads the shortcut's and the
         Programs-and-Features icon by that name's extension. v0.1.0-alpha.4 named it
         "OpenStitchIcon", and every installed shortcut showed the generic icon. -->
    <Icon Id="openstitch.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="openstitch.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="OpenStitch">
          <!-- The ready-to-sew kit (examples/sew), harvested into the SewKit component group by
               heat.exe at build time; Help ▸ Ready-to-Sew Designs opens it. -->
          <Directory Id="SewKitFolder" Name="sew" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="dc762be0-0c4f-46f5-9612-3c54e83dd4bd" Win64="yes">
        <File Id="OpenStitchExe" Source="$(var.Binary)" Name="openstitch.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="OpenStitch"
                    WorkingDirectory="INSTALLFOLDER" Icon="openstitch.ico" Advertise="yes" />
        </File>

        <!-- .osd: OpenStitch's own project format, opened by default. -->
        <ProgId Id="OpenStitch.Design" Description="OpenStitch Design" Icon="openstitch.ico" Advertise="yes">
          <Extension Id="osd" ContentType="application/x-openstitch-design">
            <Verb Id="open" Command="Open" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\openstitch.exe\SupportedTypes"
                       Name=".osd" Value="" Type="string" />
      </Component>
      <!-- .pes: offered under "Open with" only; the existing default handler is kept. -->
      <Component Id="PesAssociation" Guid="8d52fea5-942d-48b9-94ac-db3d29321752" Win64="yes">
        <File Id="OpenStitchIco" Source="$(var.Icon)" Name="openstitch.ico" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\OpenStitch.PES" Value="PES Embroidery File" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\OpenStitch.PES\DefaultIcon" Value="[#OpenStitchIco]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\OpenStitch.PES\shell\open\command"
                       Value="&quot;[#OpenStitchExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pes\OpenWithProgids" Name="OpenStitch.PES"
                       Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\openstitch.exe\SupportedTypes"
                       Name=".pes" Value="" Type="string" />
      </Component>
      <!-- Explorer thumbnails (#669): packaging/windows/thumbnails, one class per extension (a
           stream has no file name). Uninstall removes the DLL and every key below. -->
      <Component Id="ExplorerThumbnails" Guid="d78d4f16-f8ab-4e9b-b12b-69a5b6c053db" Win64="yes">
        <File Id="ThumbnailsDll" Source="$(var.Thumbnails)" Name="openstitch_explorer_thumbnails.dll" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620000}" Value="OpenStitch thumbnail (.osd)" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620000}\InprocServer32" Value="[#ThumbnailsDll]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620000}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.osd\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Value="{4F70656E-5374-6974-6368-54686D620000}" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620001}" Value="OpenStitch thumbnail (.pes)" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620001}\InprocServer32" Value="[#ThumbnailsDll]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620001}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pes\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Value="{4F70656E-5374-6974-6368-54686D620001}" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620002}" Value="OpenStitch thumbnail (.pec)" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620002}\InprocServer32" Value="[#ThumbnailsDll]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620002}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pec\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Value="{4F70656E-5374-6974-6368-54686D620002}" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620003}" Value="OpenStitch thumbnail (.dst)" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620003}\InprocServer32" Value="[#ThumbnailsDll]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620003}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dst\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Value="{4F70656E-5374-6974-6368-54686D620003}" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620004}" Value="OpenStitch thumbnail (.exp)" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620004}\InprocServer32" Value="[#ThumbnailsDll]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{4F70656E-5374-6974-6368-54686D620004}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.exp\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Value="{4F70656E-5374-6974-6368-54686D620004}" Type="string" />
